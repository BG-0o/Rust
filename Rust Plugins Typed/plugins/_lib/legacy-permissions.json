{
  "anonymous-files": {
    "discord": [
      "POST /channels/*/messages"
    ],
    "messages": true
  },
  "auto-dnd": {
    "gatewaySend": [
      3
    ],
    "messages": true
  },
  "blur-nsfw": {
    "gateway": [
      "ready",
      "guildCreate",
      "initialGuild",
      "channelCreate",
      "channelUpdate",
      "threadCreate",
      "threadUpdate",
      "messageCreate",
      "messageUpdate"
    ],
    "discord": [
      "GET /channels/*",
      "GET /channels/*/messages"
    ],
    "stores": true,
    "messages": true
  },
  "custom-rpc": {
    "gatewaySend": [
      3
    ],
    "messages": true,
    "discord": [
      "POST /applications/*/external-assets",
      "GET /oauth2/applications/*/assets"
    ]
  },
  "game-activity-toggle": {
    "gatewaySend": [
      3
    ],
    "discord": [
      "PATCH /users/@me/settings-proto/1"
    ],
    "messages": true
  },
  "i-love-spam": {
    "gateway": [
      "messageCreate",
      "messageUpdate"
    ],
    "discord": [
      "GET /channels/*/messages"
    ]
  },
  "ignore-activities": {
    "gatewaySend": [
      3
    ],
    "messages": true
  },
  "ignore-calls": {
    "gateway": [
      "callCreate",
      "callUpdate",
      "messageCreate"
    ],
    "discord": [
      "GET /users/@me"
    ],
    "messages": true
  },
  "keyword-notify": {
    "gateway": [
      "ready",
      "guildCreate",
      "messageCreate"
    ],
    "discord": [
      "GET /users/@me"
    ],
    "messages": true
